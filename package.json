		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@zerodevx/svelte-toast": "^0.9.6",
		"aos": "^3.0.0-beta.6",
		"bootstrap": "^5.3.8",
		"pocketbase": "^0.28.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"super-sitemap": "^2.0.6",
		"typescript": "^6.0.3",
		"uuid": "^14.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"sharp": "^0.35.5",
