BODY_SIZE_LIMIT=15728640
# Must match the URL visitors use in the browser (CSRF/origin checks).
ORIGIN=https://yourdomain.com
PRIVATE_LOGIN_PASSWORD=PasswordForAdminPanel
PRIVATE_LOGIN_USERNAME=yourusername
PRIVATE_POCKETBASE_EMAIL=PocketbaseAdminEmail@emaildomain.com
PRIVATE_POCKETBASE_PASSWORD=PocketbaseAdminPassword
TUNNEL_TOKEN=cloudflaredtoken

# Default (all-in-one Dockerfile): leave these commented out. PocketBase runs
# in the same container, stores data in the `pocketbase_data` Docker volume,
# and files are served through https://yourdomain.com/pb/.
# POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
# PUBLIC_POCKETBASE_URL=/pb

# Optional split deployment: set the private server URL used by SvelteKit and
# the browser-visible URL separately. The two may be the same public HTTPS URL.
# POCKETBASE_EMBEDDED=false
# POCKETBASE_INTERNAL_URL=https://pocketbase.yourdomain.com
# PUBLIC_POCKETBASE_URL=https://pocketbase.yourdomain.com
# Set false only when PUBLIC_POCKETBASE_URL goes directly to PocketBase.
# POCKETBASE_PROXY_ENABLED=false
# Legacy alias, retained for existing deployments; normally leave unset.
# PUBLIC_POCKETBASE_URL_IMG_API=https://pocketbase.yourdomain.com/api/files/
# Optional allow-list for external image hosts in the integrated transformer.
# The default all-in-one setup already permits the internal `website` host.
# IMAGE_PROXY_ALLOWED_REMOTE_DOMAINS=images.example.com,pocketbase.example.com
# Image optimization is OFF by default in compose.yml (original images are
# served). To enable the bundled transformer stack, run with the "images"
# profile and uncomment the next line:
# docker compose --profile images up -d --build
# IMAGE_PROXY_INTERNAL_URL=http://image-transformer:3000
# For a separately hosted transformer, point SvelteKit at its private URL.
# IMAGE_PROXY_INTERNAL_URL=https://images.yourdomain.com
# For a legacy browser-direct transformer endpoint only (baked in at build time):
# PUBLIC_IMAGE_PROXY_URL=https://images.yourdomain.com/image/

# Optional: YouTube animated preview generation on VPS (yt-dlp bot checks)
# Datacenter IPs are often blocked; non-web clients are tried first automatically.
# If downloads still fail with "Sign in to confirm you're not a bot", export Netscape
# cookies from a browser logged into YouTube and provide them here:
#   https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# YTDLP_COOKIES=            # alternative: paste full cookies.txt content (use \n for newlines)
# YTDLP_PROXY=              # optional http:// or socks5:// proxy
# YTDLP_EXTRA_ARGS=         # optional extra yt-dlp flags (space-separated)
