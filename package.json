{
	"name": "mzey-svelte",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
